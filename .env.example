# Public client settings. Use the publishable key on new Supabase projects.
# The legacy anon key is also accepted (NEXT_PUBLIC_SUPABASE_ANON_KEY) until you rotate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only. Never prefix these with NEXT_PUBLIC_.
# New projects: Settings → API Keys → secret key (sb_secret_...).
# Older projects: Legacy service_role key.
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Comma-separated emails allowed to open the platform admin.
# You can also set profiles.is_platform_admin in SQL (see README). Do not put this flag in user metadata.
ADMIN_EMAILS=you@school.edu.gh

# SMS is sent only from the server, and only when SMS_LIVE=true.
# Arkesel is the default when SMS_PROVIDER is omitted. Also accepted: hubtel, mnotify.
# Hubtel also needs SMS_CLIENT_ID. Leave SMS_LIVE unset until the credentials are real.
# The key is never stored on a school row and never sent to the browser.
SMS_PROVIDER=arkesel
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_SENDER_ID=SchoolGH
SMS_LIVE=false

# Paystack mobile-money links. Server only. Use a test secret (sk_test_...) first.
# sk_live_ keys are ignored unless PAYSTACK_LIVE=true.
# Webhook URL: https://YOUR_DOMAIN/api/paystack/webhook
# PAYSTACK_PUBLIC_KEY is optional for this link flow and must not be the secret.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_LIVE=false

# Optional public support contacts shown in the app.
NEXT_PUBLIC_SUPPORT_WHATSAPP=233530710628
NEXT_PUBLIC_SUPPORT_EMAIL=
