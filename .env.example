# School and admin sample data. Off unless this is exactly true.
# Leave it unset in production so visitors sign in with real credentials.
# Set it for local work or a preview that should show the demo buttons.
# NEXT_PUBLIC_DEMO_MODE=true

# Which deploy this is: development, staging, or production.
# Leave both unset for local work (treated as development).
# Staging and production are separate Supabase projects and separate Vercel env sets.
# Set both to the same value. NEXT_PUBLIC_APP_ENV is inlined at build time.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Public client settings. Use the publishable key on new Supabase projects.
# The legacy anon key is also accepted (NEXT_PUBLIC_SUPABASE_ANON_KEY) until you rotate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server only. Never prefix these with NEXT_PUBLIC_.
# New projects: Settings → API Keys → secret key (sb_secret_...).
# Older projects: Legacy service_role key.
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Comma-separated emails allowed to open the platform admin.
# You can also set profiles.is_platform_admin in SQL (see README). Do not put this flag in user metadata.
ADMIN_EMAILS=you@school.edu.gh

# SMS is sent only from the server, and only when SMS_LIVE=true.
# Arkesel is the default when SMS_PROVIDER is omitted. Also accepted: hubtel, mnotify.
# Hubtel also needs SMS_CLIENT_ID. Leave SMS_LIVE unset until the credentials are real.
# The key is never stored on a school row and never sent to the browser.
SMS_PROVIDER=arkesel
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_SENDER_ID=SchoolGH
SMS_LIVE=false

# Paystack mobile-money links. Server only. Use a test secret (sk_test_...) first.
# sk_live_ keys are ignored unless PAYSTACK_LIVE=true.
# Webhook URL: https://YOUR_DOMAIN/api/paystack/webhook
# PAYSTACK_PUBLIC_KEY is optional for this link flow and must not be the secret.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_LIVE=false

# Optional public support contacts shown in the app.
NEXT_PUBLIC_SUPPORT_WHATSAPP=233530710628
NEXT_PUBLIC_SUPPORT_EMAIL=

# Sentry. EU organization build-with-innocent, project schoolledgergh.
# The DSN is public. Set both so the browser and the server read the same value.
# Next inlines NEXT_PUBLIC_SENTRY_DSN at build time.
NEXT_PUBLIC_SENTRY_DSN=https://f8b70d3938fa9fe24ad297ac88ef3ef6@o4512244866744320.ingest.de.sentry.io/4512244869890128
SENTRY_DSN=https://f8b70d3938fa9fe24ad297ac88ef3ef6@o4512244866744320.ingest.de.sentry.io/4512244869890128
SENTRY_ORG=build-with-innocent
SENTRY_PROJECT=schoolledgergh
# Source map upload. Leave the token empty until CI has a Sentry auth token.
# Leave SENTRY_URL unset for an organization token. Set it for a personal token on the EU host.
# SENTRY_URL=https://de.sentry.io
SENTRY_AUTH_TOKEN=
